# Local development only. Copy to infra/.env and change every password.
# infra/.env is git-ignored and must never be committed.

# Database created on first start; POSTGRES_USER is the admin/migration role.
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot_admin
POSTGRES_PASSWORD=troque_esta_senha

# Application roles created by postgres/init/01-init.sh.
API_DB_PASSWORD=troque_esta_senha_api
RAG_DB_PASSWORD=troque_esta_senha_rag

# Host ports (bound to 127.0.0.1 only).
DB_PORT=5432
REDIS_PORT=6379
